libtint = static_library('tint',
    tint_src,
    cpp_args : tint_args,
    dependencies : [spirv_tools_dep, spirv_headers_dep],
    build_by_default : false,
    gnu_symbol_visibility : 'hidden',
    override_options : ['cpp_std=c++20'],
)

tint_dep = declare_dependency(
    compile_args : tint_args,
    link_with : libtint,
    include_directories : include_directories('src'),
    dependencies : spirv_tools_dep,
)

taint_link_args = []
taint_link_depends = []
version_script = meson.current_source_dir() / 'taint.map'
version_script_arg = '-Wl,--version-script=' + version_script
cxx = meson.get_compiler('cpp')

# sadly -fvisibility=hidden is not enough; libstdc++ template crap somehow leaks exported symbols
if cxx.has_link_argument(version_script_arg)
    taint_link_args += version_script_arg
    taint_link_depends += files('taint.map')
endif

libtaint = library('taint',
    'taint.cc',
    cpp_shared_args: ['-DTAINT_BUILDING_SHARED'],
    link_args : taint_link_args,
    link_depends : taint_link_depends,
    build_by_default : not meson.is_subproject(),
    install : do_install,
    dependencies : tint_dep,
    gnu_symbol_visibility : 'hidden',
    version : meson.project_version(),
    include_directories : include_directories('include'),
)

if do_install
    install_headers('include/taint.h')

    pkgconf = import('pkgconfig')
    pkgconf.generate(libtaint,
      description : 'SPIR-V to WGSL translation library based on tint',
    )
endif

taint_dep = declare_dependency(
    include_directories : include_directories('include'),
    link_with : libtaint,
)

meson.override_dependency('taint', taint_dep)

if build_spv2wgsl
  add_languages('c', native : false)
  executable('spv2wgsl', 'spv2wgsl.c',
    install : false,
    build_by_default : true,
    dependencies : taint_dep,
  )
endif
