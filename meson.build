project('taint', 'cpp',
    version : '0.0.0',
    license : 'BSD-3-Clause AND Zlib',
    license_files : 'LICENSE',
    meson_version : '>=1.3',
    default_options : [
        'cpp_std=c++20',
        'cpp_rtti=false',
        'cpp_eh=none',
        'warning_level=3',
    ],
)

do_install = not meson.is_subproject()
build_spv2wgsl = not meson.is_subproject()

# tint abuses spirv-opt's private parts; this is always going to pull in the subproject
# why? because fuck you that's why. thank you google. can't miss an opportunity to make
# your code as difficult as possible to reuse.
# NOTE: must be static; the subproject's lib is not versioned and not installed
spirv_tools_dep = (subproject('SPIRV-Tools', default_options : ['default_library=static']).
    get_variable('spirv_tools_opt_internal_dep'))

# this must come after SPIRV-Tools, because its subproject wants to use the subproject
# version of SPIRV-Headers.
spirv_headers_dep = dependency('SPIRV-Headers')

tint_args = [
    '-DDAWN_HAVE_UTILS_BUILD_CONFIG',
    '-DTINT_ENABLE_IR_DUMPING=0',
    '-DTINT_ENABLE_IR_VALIDATION_ASSERTS=0',
]

b_ndebug = get_option('b_ndebug')
ndebug = b_ndebug == 'true' or (b_ndebug == 'if-release' and get_option('buildtype') in ['release', 'plain'])

if not ndebug
    tint_args += '-DDAWN_ENABLE_ASSERTS'
endif

# currently only includes stuff necessary for spirv->wgsl

tint_src = files(
